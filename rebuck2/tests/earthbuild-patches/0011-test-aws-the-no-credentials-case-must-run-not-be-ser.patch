From 4ab8ed3330c36243221a9d588d33039c6ded7958 Mon Sep 17 00:00:00 2001
From: Giles Cope <gilescope@gmail.com>
Date: Sun, 2 Aug 2026 07:45:35 +0100
Subject: [PATCH 11/12] test(aws): the no-credentials case must run, not be
 served

tests+test-aws-flag-none builds aws-flag.earth with NO credentials and expects
"failed to load AWS credentials"; its two siblings build the same target WITH
them. Credentials, like secrets, are deliberately not part of a buildkit cache
key -- so on a shared daemon the no-credentials run hit a credentialled run cache,
loaded nothing, and passed. Second negative test to go green this way.

That is now a named class rather than two incidents: a should_fail test whose
failure depends on something ABSENT from the cache key -- a secret, a
credential, an environment -- cannot be served from cache and still mean
anything. There are 88 should_fail call sites; these are the two the twelve-group
sweep has reached so far.

Assisted-by: Claude:claude-opus-5 claude-code
---
 tests/aws-flag.earth | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/tests/aws-flag.earth b/tests/aws-flag.earth
index 46702c9e..1f4a755f 100644
--- a/tests/aws-flag.earth
+++ b/tests/aws-flag.earth
@@ -3,4 +3,9 @@ VERSION --run-with-aws 0.8
 FROM alpine:3.24.1
 
 basic:
-    RUN --aws env | grep AWS
+    # tests+test-aws-flag-none builds this with NO credentials and expects
+    # "failed to load AWS credentials"; its siblings build it WITH them. Like
+    # secrets, credentials are not part of a buildkit cache key, so on a shared
+    # daemon the no-credentials run hit a credentialled run's cache, never
+    # loaded anything, and passed -- another negative test going green.
+    RUN --no-cache --aws env | grep AWS
