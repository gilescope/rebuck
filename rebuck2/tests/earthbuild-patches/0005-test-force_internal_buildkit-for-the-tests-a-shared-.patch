From 6222051168a9cbb99a40674619f88a2952dde94e Mon Sep 17 00:00:00 2001
From: Giles Cope <gilescope@gmail.com>
Date: Sat, 1 Aug 2026 07:42:06 +0100
Subject: [PATCH 05/12] test: force_internal_buildkit, for the tests a shared
 daemon would change

Sharing one buildkit across the suite changes the meaning of exactly one
command. LOCALLY runs on the DAEMON's host, so a nested LOCALLY under a shared
daemon writes its files on the OUTER machine and the assertion that follows
looks for them on the inner one. Measured on group1:

    ERROR tests/locally-in-function/Earthfile:20:5
    cat: can't open '/the-test/data': No such file or directory

So RUN_EARTHLY grows an opt-out, and the tests whose inner Earthfile contains
LOCALLY take it: locally-in-command, locally-in-function, and the if/for/
first-command fixtures. That is a deliberate, bounded loss of consolidation --
five call sites -- rather than a suite-wide retreat.

The unset covers all three spellings of the address. earthly reads
EARTH_BUILDKIT_HOST first and falls back to EARTHLY_, and earthly-entrypoint.sh
now decides on the same set; dropping only the bare name would leave the
prefixed one to reintroduce the daemon we are trying to avoid.

Assisted-by: Claude:claude-opus-5 claude-code
---
 tests/Earthfile                     | 32 +++++++++++++++++++++++------
 tests/locally-in-command/Earthfile  |  3 +++
 tests/locally-in-function/Earthfile |  3 +++
 3 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/tests/Earthfile b/tests/Earthfile
index 3dae33b0..0cc5e86b 100644
--- a/tests/Earthfile
+++ b/tests/Earthfile
@@ -1211,16 +1211,16 @@ arg-set:
 
 if:
     RUN touch exists-locally
-    DO +RUN_EARTHLY --earthfile=if.earth
+    DO +RUN_EARTHLY --earthfile=if.earth --force_internal_buildkit=true
 
 for:
-    DO +RUN_EARTHLY --earthfile=for.earth
+    DO +RUN_EARTHLY --earthfile=for.earth --force_internal_buildkit=true
 
 first-command:
-    DO +RUN_EARTHLY --earthfile=first-command.earth --target=+all-positive
-    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-run
-    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-if
-    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-non-from-target
+    DO +RUN_EARTHLY --earthfile=first-command.earth --target=+all-positive --force_internal_buildkit=true
+    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-run --force_internal_buildkit=true
+    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-if --force_internal_buildkit=true
+    DO +RUN_EARTHLY --earthfile=first-command.earth --should_fail=true --target=+start-with-non-from-target --force_internal_buildkit=true
 
 platform-output:
     DO +RUN_EARTHLY --earthfile=platform-output.earth
@@ -1696,11 +1696,31 @@ RUN_EARTHLY:
     ARG output_does_not_contain=""
     ARG grep_flags=""
     ARG verbose=1
+    # One buildkit, not one per test -- except where a test's meaning depends on
+    # having its own.
+    #
+    # earthly forwards its buildkit settings into every RUN, so a nested earthly
+    # reaches the daemon that started it instead of standing up another. That is
+    # the point: a daemon per test is a daemon per test's worth of cold base
+    # image pulls, which is what earthbuild currently buys Docker Hub credentials
+    # to survive (Earthfile:564).
+    #
+    # It changes the meaning of exactly one command. LOCALLY runs on the DAEMON's
+    # host, so a nested LOCALLY under a shared daemon writes its files on the
+    # OUTER machine, where the assertion that follows cannot see them. Measured:
+    # locally-in-function+test-function-in-sub-dir, "cat: can't open
+    # /the-test/data". Tests whose inner Earthfile contains LOCALLY set this, and
+    # declare themselves by doing so.
+    ARG force_internal_buildkit=false
     IF [ ! -z "$earthfile" ]
         COPY "$earthfile" "$earthfile_dest"
     END
     RUN echo "
         set -ex
+        if $force_internal_buildkit; then
+            unset EARTH_BUILDKIT_HOST EARTHLY_BUILDKIT_HOST BUILDKIT_HOST
+            unset EARTH_TLS_ENABLED EARTHLY_TLS_ENABLED
+        fi
         export EARTHLY_VERBOSE=$verbose
         if $use_tmpfs; then
             export EARTHLY_TMP_DIR=/tmp/earthbuild-tmpfs
diff --git a/tests/locally-in-command/Earthfile b/tests/locally-in-command/Earthfile
index 58a98065..e4d0a61a 100644
--- a/tests/locally-in-command/Earthfile
+++ b/tests/locally-in-command/Earthfile
@@ -52,7 +52,10 @@ RUN_EARTHLY_ARGS:
     ARG earthfile
     ARG target
     ARG should_fail=false
+    # LOCALLY runs on the daemon's host, and this suite asserts on files the
+    # nested build wrote HERE -- so it needs its own daemon, not the caller's.
     DO --pass-args tests+RUN_EARTHLY \
+        --force_internal_buildkit=true \
         --earthfile=$earthfile \
         --target=$target \
         --should_fail=$should_fail
diff --git a/tests/locally-in-function/Earthfile b/tests/locally-in-function/Earthfile
index 9ab21561..3c6f192f 100644
--- a/tests/locally-in-function/Earthfile
+++ b/tests/locally-in-function/Earthfile
@@ -52,7 +52,10 @@ RUN_EARTHLY_ARGS:
     ARG earthfile
     ARG target
     ARG should_fail=false
+    # LOCALLY runs on the daemon's host, and this suite asserts on files the
+    # nested build wrote HERE -- so it needs its own daemon, not the caller's.
     DO --pass-args tests+RUN_EARTHLY \
+        --force_internal_buildkit=true \
         --earthfile=$earthfile \
         --target=$target \
         --should_fail=$should_fail
