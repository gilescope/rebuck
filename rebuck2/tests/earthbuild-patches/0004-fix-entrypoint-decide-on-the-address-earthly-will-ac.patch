From 0a9539f06c4aa5c456f0eec2543eb79c769a5192 Mon Sep 17 00:00:00 2001
From: Giles Cope <gilescope@gmail.com>
Date: Sat, 1 Aug 2026 07:36:34 +0100
Subject: [PATCH 04/12] fix(entrypoint): decide on the address earthly will
 actually use

The entrypoint's rule is "external if given, internal otherwise", but it read
the bare BUILDKIT_HOST while earthly reads EARTH_BUILDKIT_HOST first and falls
back to the deprecated EARTHLY_ prefix (internal/env.Lookup). A nested earthly
is handed the prefixed form by its caller, so the two disagreed: the container
started a buildkitd, then earthly ignored it and built against the caller's
daemon anyway.

That is worse than no forwarding at all. Measured on
./tests/command-to-function-rename+all, counting the internal branch's own
"running under pid=" line:

    pristine (no forwarding)          4 internal daemons   PASS
    forwarding, entrypoint unchanged  5 internal daemons   FAIL
    forwarding, this fix              0 internal daemons   PASS

The failure was not the parse error the graph shows first. The internal branch
symlinks /etc/ca.pem to a cert that bootstrap no longer writes once TLS is off,
and `[ ! -f ]` on a dangling symlink is true -- so the second invocation in a
chained RUN re-runs `ln` and dies on "File exists", under `set -e`. The
"function recipes must start with FUNCTION" line nearby is expected output from
a should_fail=true test, and reading it as the cause cost a diagnosis.

Assisted-by: Claude:claude-opus-5 claude-code
---
 earthly-entrypoint.sh | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/earthly-entrypoint.sh b/earthly-entrypoint.sh
index 183773b9..e0e18e49 100755
--- a/earthly-entrypoint.sh
+++ b/earthly-entrypoint.sh
@@ -24,9 +24,18 @@ if [ ! -f "$earthly_config" ]; then
   fi
 fi
 
-# If no host specified, start an internal buildkit. If it is specified, rely on external setup
+# If no host specified, start an internal buildkit. If it is specified, rely on external setup.
+#
+# "Specified" has to mean the same thing here as it does to earthly, which reads
+# EARTH_BUILDKIT_HOST first and falls back to the deprecated EARTHLY_ prefix
+# (internal/env.Lookup). A nested earthly is handed the prefixed form by its
+# caller, so deciding on the bare variable alone makes the two disagree: this
+# script starts an internal daemon, then earthly ignores it and builds against
+# the caller's anyway. The container pays for a buildkitd nobody uses, and the
+# TLS branch below generates certs for it that the external daemon does not want.
+buildkit_host="${BUILDKIT_HOST:-${EARTH_BUILDKIT_HOST:-${EARTHLY_BUILDKIT_HOST:-}}}"
 if [ -z "$NO_BUILDKIT" ]; then
-  if [ -z "$BUILDKIT_HOST" ]; then
+  if [ -z "$buildkit_host" ]; then
     if ! captest --text | grep sys_admin > /dev/null; then
       echo 1>&2 "Container appears to be running unprivileged. Currently, privileged mode is required when buildkit runs inside the container."
       echo 1>&2 "To run this image without buildkit, set the environment variable NO_BUILDKIT=1"
@@ -70,7 +79,7 @@ if [ -z "$NO_BUILDKIT" ]; then
     EARTHLY_BUILDKIT_HOST="tcp://$(hostname):8372" # hostname is not recognized as local for this reason
     export EARTHLY_BUILDKIT_HOST
   else
-    export EARTHLY_BUILDKIT_HOST="$BUILDKIT_HOST"
+    export EARTHLY_BUILDKIT_HOST="$buildkit_host"
   fi
   ! "$EARTHLY_DEBUG" || echo 1>&2 "Using $EARTHLY_BUILDKIT_HOST as buildkit daemon"
 fi
