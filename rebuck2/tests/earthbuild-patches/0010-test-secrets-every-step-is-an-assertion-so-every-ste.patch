From 9441046e8c708e13d0a783a69a8cfd864306b9ba Mon Sep 17 00:00:00 2001
From: Giles Cope <gilescope@gmail.com>
Date: Sun, 2 Aug 2026 07:38:26 +0100
Subject: [PATCH 10/12] test(secrets): every step is an assertion, so every
 step must run

tests+secrets-test builds secrets.earth twice: once WITH --secret-file SECRET3,
once without, expecting the second to fail with

    unable to lookup secret "SECRET3": not found

It passed. Not "failed differently" -- passed. A negative test went green, which
is the dangerous direction and the reason this one is worth a commit of its own.

Secret VALUES are deliberately excluded from buildkit cache keys, so that
rotating a secret does not invalidate a build. The two invocations therefore
produce identical keys, and on a shared daemon the second hit the first's cache,
never performed the lookup, and reported success.

Worth being clear that buildkit is not wrong here. A cached step has nothing to
look up. The test was relying on a cold daemon to force the lookup, and a daemon
per test gave it one for free. Marking the steps says so.

The implication reaches past the suite: under a shared daemon, a build that
would fail for a missing secret can succeed from cache. That is a real behaviour
change for anyone running consolidated, not just for these tests.

Assisted-by: Claude:claude-opus-5 claude-code
---
 tests/secrets.earth | 60 ++++++++++++++++++++++++++-------------------
 1 file changed, 35 insertions(+), 25 deletions(-)

diff --git a/tests/secrets.earth b/tests/secrets.earth
index 8192dcf8..64d16d69 100644
--- a/tests/secrets.earth
+++ b/tests/secrets.earth
@@ -1,31 +1,41 @@
 VERSION 0.8
 FROM alpine:3.24.1
+
+# Every step here is an ASSERTION about secret plumbing, so every step has to
+# run. That was free under a daemon per test, where the inner build was always
+# cold. On a shared daemon it is not, and the failure is the dangerous
+# direction: tests+secrets-test runs this target twice, once WITH
+# --secret-file SECRET3 and once without, and expects the second to fail with
+# "unable to lookup secret SECRET3: not found". Secret VALUES are deliberately
+# not part of a buildkit cache key, so the second run hit the first run's cache,
+# never looked the secret up, and passed -- "ERROR: earthly should have failed
+# but didn't". A negative test that goes green is worse than one that goes red.
 test:
     WORKDIR /test
     ARG SECRET_ID=+secrets/SECRET1
     ARG SECRET_ID_2=SECRET2
-    RUN --secret=SECRET1=+secrets/SECRET1 test "$SECRET1" == "foo"
-    RUN test -z "$SECRET1"
-    RUN --secret=SECRET1 test "$SECRET1" == "foo"
-    RUN test -z "$SECRET1"
-    RUN --secret=SECRET2=+secrets/SECRET2 test "$SECRET2" == "bar"
-    RUN test -z "$SECRET2"
-    RUN --secret=SECRET2 test "$SECRET2" == "bar"
-    RUN test -z "$SECRET2"
-    RUN --secret=SECRET2=+secrets/SECRET3 test "$SECRET2" == "secretfilecontents"
-    RUN test -z "$SECRET3"
-    RUN --secret=SECRET3 test "$SECRET3" == "secretfilecontents"
-    RUN test -z "$SECRET3"
-    RUN --secret=SECRET1=$SECRET_ID test "$SECRET1" == ""
-    RUN test -z "$SECRET1"
-    RUN --secret=$SECRET_ID_2 test "$SECRET2" == ""
-    RUN test -z "$SECRET2"
-    RUN --mount=type=secret,id=+secrets/SECRET1,target=/root/secret1 test "$(cat /root/secret1)" == "foo"
-    RUN ! /root/secret1
-    RUN --mount=type=secret,id=+secrets/SECRET2,target=/root/secret2 test "$(cat /root/secret2)" == "bar"
-    RUN ! /root/secret2
-    RUN --mount=type=secret,id=+secrets/SECRET3,target=/root/secret3 test "$(cat /root/secret3)" == "secretfilecontents"
-    RUN ! /root/secret3
-    RUN --mount=type=secret,id=+secrets/SECRET1,mode=0100,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "---x------"
-    RUN --mount=type=secret,id=+secrets/SECRET1,mode=0200,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "--w-------"
-    RUN --mount=type=secret,id=+secrets/SECRET1,mode=0400,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "-r--------"
+    RUN --no-cache --secret=SECRET1=+secrets/SECRET1 test "$SECRET1" == "foo"
+    RUN --no-cache test -z "$SECRET1"
+    RUN --no-cache --secret=SECRET1 test "$SECRET1" == "foo"
+    RUN --no-cache test -z "$SECRET1"
+    RUN --no-cache --secret=SECRET2=+secrets/SECRET2 test "$SECRET2" == "bar"
+    RUN --no-cache test -z "$SECRET2"
+    RUN --no-cache --secret=SECRET2 test "$SECRET2" == "bar"
+    RUN --no-cache test -z "$SECRET2"
+    RUN --no-cache --secret=SECRET2=+secrets/SECRET3 test "$SECRET2" == "secretfilecontents"
+    RUN --no-cache test -z "$SECRET3"
+    RUN --no-cache --secret=SECRET3 test "$SECRET3" == "secretfilecontents"
+    RUN --no-cache test -z "$SECRET3"
+    RUN --no-cache --secret=SECRET1=$SECRET_ID test "$SECRET1" == ""
+    RUN --no-cache test -z "$SECRET1"
+    RUN --no-cache --secret=$SECRET_ID_2 test "$SECRET2" == ""
+    RUN --no-cache test -z "$SECRET2"
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET1,target=/root/secret1 test "$(cat /root/secret1)" == "foo"
+    RUN --no-cache ! /root/secret1
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET2,target=/root/secret2 test "$(cat /root/secret2)" == "bar"
+    RUN --no-cache ! /root/secret2
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET3,target=/root/secret3 test "$(cat /root/secret3)" == "secretfilecontents"
+    RUN --no-cache ! /root/secret3
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET1,mode=0100,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "---x------"
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET1,mode=0200,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "--w-------"
+    RUN --no-cache --mount=type=secret,id=+secrets/SECRET1,mode=0400,target=/root/secret1 test "$(ls -la /root/secret1 | awk '{print $1}')" = "-r--------"
