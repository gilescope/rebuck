+// forwardedEnvSuffixes are the settings earthly hands down to a nested earthly,
+// as suffixes for env.Lookup (which owns the EARTH_/EARTHLY_ prefix pair).
+//
+// EXPLICIT, not a prefix match. EARTH_*/EARTHLY_* on a build host includes
+// credentials -- earthbuild's own tests carry DOCKERHUB_AUTH and
+// DOCKERHUB_MIRROR_PASS -- and a prefix rule would copy them into every
+// container AND into cache keys that are then shared across the fleet.
+//
+// The bar for adding an entry is not "not secret" but SAFE TO PUBLISH: a
+// forwarded value lands in the image config, so it shows up in docker inspect of
+// any exported image and in the lease-key debug string.
+var forwardedEnvSuffixes = []string{
+	// Where the daemon is. Value is tcp://buildkitsandbox:8372 --
+	// buildkitsandbox is a buildkit constant (executor/oci/hosts.go), written
+	// into every exec's /etc/hosts, so the STRING is identical on every machine
+	// while resolving locally. That is what keeps forwarding from poisoning
+	// cache keys: a machine-specific address would make every forwarded RUN
+	// unmergeable and quietly undo cross-machine single-flight.
+	"BUILDKIT_HOST",
+	// How to speak to it. Without this a nested earthly dials the daemon,
+	// defaults to TLS, and dies on a CA nobody gave it.
+	"TLS_ENABLED",
+}
+
+// CollectForwardedBuildkitEnv reads the settings to hand down, and must be
+// called CLI-side.
+//
+// The converter cannot do this itself: it runs inside buildkitd's gateway, so
+// os.LookupEnv there returns the daemon's environment. That was measured, not
+// assumed -- a debug print from the converter never reached the CLI's stderr.
+func CollectForwardedBuildkitEnv() map[string]string {
+	out := map[string]string{}
+	for _, suffix := range forwardedEnvSuffixes {
+		if suffix == "BUILDKIT_HOST" {
+			// NOT this CLI's address. Ours names the daemon from the HOST --
+			// a container IP, or a socket -- and neither means anything inside
+			// an exec. sandboxBuildkitHost is how the same daemon is reached
+			// from in there, and it is a constant, which is also what keeps
+			// forwarding from poisoning cache keys.
+			//
+			// Only forwarded when this earthly is itself using a daemon: if it
+			// is not, there is nothing for a nested build to share.
+			if _, ok := env.Lookup(suffix); ok {
+				out[env.Prefix+suffix] = sandboxBuildkitHost
+			}
+			continue
+		}
+		if v, ok := env.Lookup(suffix); ok && v != "" {
+			out[env.Prefix+suffix] = v
+		}
+	}
+	return out
+}
+
+// sandboxBuildkitHost is how a nested build reaches the daemon running this
+// build. buildkitsandbox is a buildkit constant (executor/oci/hosts.go) written
+// into every exec's /etc/hosts, so this string is identical on every machine
+// while resolving locally -- and identical strings are what let forwarded RUNs
+// still merge across a fleet.
+const sandboxBuildkitHost = "tcp://buildkitsandbox:8372"
+
+// forwardBuildkitEnv puts the caller-supplied settings into the RUN
+// environment, so an earthly invoked inside that RUN finds them.
+//
+// This is the only mechanism that works at depth. A caller's environment does
+// NOT reach a RUN step (measured), and a config file lives in one container --
+// so without forwarding, level 2 inherits nothing and starts its own daemon,
+// which is how a CI run ends up with one cold buildkitd per test.
+func forwardBuildkitEnv(state pllb.State, fwd map[string]string) pllb.State {
+	for _, k := range sortedKeys(fwd) {
+		state = state.AddEnv(k, fwd[k])
+	}
+	return state
+}
+
+// sortedKeys keeps the env deterministic: map order would otherwise vary the
+// LLB, and a vertex that differs run to run cannot merge across machines.
+func sortedKeys(m map[string]string) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
