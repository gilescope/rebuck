diff --git a/earthfile2llb/forward_env_test.go b/earthfile2llb/forward_env_test.go
new file mode 100644
index 00000000..377dff6d
--- /dev/null
+++ b/earthfile2llb/forward_env_test.go
@@ -0,0 +1,63 @@
+package earthfile2llb
+
+import "testing"
+
+// Forwarding earthly's own buildkit settings into RUN environments is what makes
+// a NESTED earthly work at any depth: level 1 sets them, level 2 inherits and
+// re-forwards, and so on. Nothing else crosses -- measured, a caller's env does
+// not reach a RUN step, and a config file lives in one container.
+//
+// The list is EXPLICIT, not a prefix match. EARTH_*/EARTHLY_* on a build host
+// includes credentials (DOCKERHUB_AUTH, DOCKERHUB_MIRROR_PASS, tokens), and a
+// prefix rule would copy them into every container AND into cache keys that are
+// then shared across the fleet. That is secret exfiltration wearing a nesting
+// fix's clothes.
+//
+// The bar for adding an entry is not "not secret" but SAFE TO PUBLISH: a
+// forwarded value lands in the image config, so it is visible in docker inspect
+// of any exported image and in the lease-key debug string.
+
+func TestForwardedEnvIsAnExplicitShortList(t *testing.T) {
+	if len(forwardedEnvSuffixes) == 0 {
+		t.Fatal("nothing forwarded means nesting cannot work at all")
+	}
+	// A short list is the invariant. If this fails, someone has started using it
+	// as a general-purpose env channel -- which is exactly what the explicit
+	// list exists to prevent.
+	if len(forwardedEnvSuffixes) > 4 {
+		t.Fatalf("forwarding %d vars: keep the list short and justified", len(forwardedEnvSuffixes))
+	}
+}
+
+// Guard the actual danger. These names, or anything shaped like them, must never
+// be forwarded -- they are the ones a build host really does carry.
+func TestForwardedEnvCarriesNoCredentials(t *testing.T) {
+	banned := []string{"TOKEN", "SECRET", "PASS", "AUTH", "KEY", "CREDENTIAL"}
+	for _, suffix := range forwardedEnvSuffixes {
+		for _, b := range banned {
+			if contains(suffix, b) {
+				t.Fatalf("%q looks credential-shaped and must not be forwarded: it lands in the image config", suffix)
+			}
+		}
+	}
+}
+
+// Suffixes, not full names: internal/env owns the EARTH_/EARTHLY_ pair and its
+// own comment says the deprecated one is a migration shim to be dropped. Naming
+// full variables here would make that removal a hunt.
+func TestForwardedEnvUsesSuffixesNotFullNames(t *testing.T) {
+	for _, suffix := range forwardedEnvSuffixes {
+		if contains(suffix, "EARTH_") || contains(suffix, "EARTHLY_") {
+			t.Fatalf("%q carries a prefix; env.Lookup owns those", suffix)
+		}
+	}
+}
+
+func contains(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
