+// applyTLSEnabledEnvOverride lets TLS be set by environment, which is the only
+// carrier that reaches a NESTED earthly.
+//
+// Every other buildkit setting already has an env binding via EarthEnvVars. TLS
+// alone was config-file only, and a config file lives in one container while a
+// nested build runs in another. So a caller could point a callee at a daemon
+// (EARTHLY_BUILDKIT_HOST does have a binding) but never tell it how to speak to
+// one -- the callee defaulted to TLS and died on a CA nobody gave it.
+//
+// env.Lookup owns the prefix pair (EARTH_ preferred, EARTHLY_ as the migration
+// shim), so this does not restate them. When the next rename comes, it lands in
+// internal/env and not here.
+//
+// Unparseable values are IGNORED rather than read as false: a typo must not
+// silently disable TLS. Failing to the safe direction matters more than
+// reporting the typo, on a path that runs at every config load.
+func applyTLSEnabledEnvOverride(config *Config) {
+	v, ok := env.Lookup("TLS_ENABLED")
+	if !ok || v == "" {
+		return
+	}
+	b, err := strconv.ParseBool(v)
+	if err != nil {
+		return
+	}
+	config.Global.TLSEnabled = b
+}
diff --git a/config/tls_env_test.go b/config/tls_env_test.go
new file mode 100644
index 00000000..c3dbcbc2
--- /dev/null
+++ b/config/tls_env_test.go
@@ -0,0 +1,92 @@
+package config
+
+import "testing"
+
+// TLS is the one buildkit setting with no env binding, and that makes nested
+// earthly invocations impossible to configure.
+//
+// Measured: env does not cross into a RUN step, and a config FILE lives in one
+// container only -- so a nested earthly inherits neither. It receives
+// EARTHLY_BUILDKIT_HOST (which does have an env binding), dials the daemon,
+// defaults to TLS, and dies looking for a CA nobody gave it:
+//
+//	could not connect to buildkit: could not read ca certificate
+//
+// An env binding is the only carrier that a caller can set for a callee it does
+// not build the image for.
+func TestTLSEnabledHonoursEnvOverride(t *testing.T) {
+	t.Setenv("EARTHLY_TLS_ENABLED", "false")
+	cfg, err := ParseYAML([]byte("global:\n  tls_enabled: true\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Global.TLSEnabled {
+		t.Fatal("env override must win over the config file, or a nested earthly cannot be told to skip TLS")
+	}
+}
+
+// The default must not move: TLS stays on unless someone asks for it off.
+// Getting this backwards would silently drop TLS for every user.
+func TestTLSEnabledDefaultsOnWithoutEnv(t *testing.T) {
+	cfg, err := ParseYAML([]byte("global: {}\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.Global.TLSEnabled {
+		t.Fatal("TLS must default to enabled")
+	}
+}
+
+// An explicit "true" in the env is honoured too -- the override is a setting,
+// not a one-way off switch.
+func TestTLSEnabledEnvCanEnable(t *testing.T) {
+	t.Setenv("EARTHLY_TLS_ENABLED", "true")
+	cfg, err := ParseYAML([]byte("global:\n  tls_enabled: false\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.Global.TLSEnabled {
+		t.Fatal("env override must be able to turn TLS on as well as off")
+	}
+}
+
+// Junk must not silently disable TLS. Anything unparseable leaves the config
+// value alone -- failing open to the SAFE direction.
+func TestTLSEnabledIgnoresUnparseableEnv(t *testing.T) {
+	t.Setenv("EARTHLY_TLS_ENABLED", "yes-please")
+	cfg, err := ParseYAML([]byte("global:\n  tls_enabled: true\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.Global.TLSEnabled {
+		t.Fatal("unparseable env must not disable TLS")
+	}
+}
+
+// The CURRENT prefix. The tests above use EARTHLY_, which env.Lookup treats as
+// the migration shim -- so on their own they would still pass if the current
+// prefix were wired up wrong.
+func TestTLSEnabledHonoursCurrentPrefix(t *testing.T) {
+	t.Setenv("EARTH_TLS_ENABLED", "false")
+	cfg, err := ParseYAML([]byte("global:\n  tls_enabled: true\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Global.TLSEnabled {
+		t.Fatal("EARTH_ prefix must be honoured")
+	}
+}
+
+// Precedence: current wins over deprecated, so a half-migrated environment
+// behaves predictably rather than depending on lookup order.
+func TestTLSEnabledCurrentPrefixWinsOverDeprecated(t *testing.T) {
+	t.Setenv("EARTH_TLS_ENABLED", "false")
+	t.Setenv("EARTHLY_TLS_ENABLED", "true")
+	cfg, err := ParseYAML([]byte("global: {}\n"), "earthly")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Global.TLSEnabled {
+		t.Fatal("EARTH_ must win over EARTHLY_ when both are set")
+	}
+}
